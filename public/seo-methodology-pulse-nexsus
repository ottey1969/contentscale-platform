// ── GEMINI API ──
async function callGemini(prompt, maxTokens=3500) {
  const resp = await fetch('https://contentscale-platform-production.up.railway.app/api/gemini-proxy', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({
      contents:[{parts:[{text:prompt}]}],
      generationConfig:{temperature:0.3,maxOutputTokens:maxTokens}
    })
  });
  if (!resp.ok) {
    const err = await resp.json().catch(()=>({}));
    throw new Error(err.error?.message||err.detail||`HTTP ${resp.status}`);
  }
  const data = await resp.json();
  return data.candidates?.[0]?.content?.parts?.[0]?.text||'';
}

// ── Extract content from HTML ──
function extractContent(html, label='page') {
  if (!html) return `[No ${label} HTML provided]`;
  const doc = new DOMParser().parseFromString(html,'text/html');
  const title = doc.querySelector('title')?.textContent||'';
  const desc = doc.querySelector('meta[name="description"]')?.getAttribute('content')||'';
  const h1 = Array.from(doc.querySelectorAll('h1')).map(e=>e.textContent.trim()).join(' | ');
  const h2s = Array.from(doc.querySelectorAll('h2')).map(e=>e.textContent.trim()).join(' · ');
  const h3s = Array.from(doc.querySelectorAll('h3')).slice(0,12).map(e=>e.textContent.trim()).join(' · ');
  const schemas = Array.from(doc.querySelectorAll('script[type="application/ld+json"]')).map(s=>s.textContent.slice(0,300)).join('\n');
  const body = (doc.body?.innerText||'').replace(/\s+/g,' ').slice(0,2500);
  const imgs = doc.querySelectorAll('img').length;
  const alts = doc.querySelectorAll('img[alt]').length;
  const intLinks = (doc.querySelectorAll('a[href]')||[]).length;
  const wordCount = (doc.body?.innerText||'').split(/\s+/).filter(Boolean).length;
  return `=== ${label.toUpperCase()} CONTENT ===
Title: ${title}
Meta desc: ${desc}
H1: ${h1}
H2s: ${h2s}
H3s (first 12): ${h3s}
Word count: ~${wordCount}
Images: ${imgs} total, ${alts} with alt text
Internal links: ${intLinks}
Schema: ${schemas||'none'}
Body extract: ${body}`;
}

