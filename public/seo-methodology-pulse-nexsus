async function quickAudit(enc, impr, ctr, pos) {
  const url = decodeURIComponent(enc);
  const prog = document.getElementById('quickProgress');
  const out = document.getElementById('quickOutput');
  prog.className='progress show';
  out.innerHTML='';out.className='output show';

  const QSTEPS = [
    {id:'q1',icon:'⚡',label:'CTR Surgery — new title + meta'},
    {id:'q2',icon:'🔥',label:'Top 5 Quick Wins'},
    {id:'q3',icon:'📈',label:'Position 11–20 query opportunities'},
  ];
  document.getElementById('quickSteps').innerHTML = QSTEPS.map(s=>`<div class="prog-step" id="step-${s.id}"><span class="prog-icon">${s.icon}</span><span>${s.label}</span></div>`).join('');
  const bar = document.getElementById('quickBar');
  const ctx = `URL: ${url}\nImpressions: ${impr}\nCTR: ${ctr}%\nPosition: ${pos}`;

  // Check if we have query data for this page
  const pageQueries = gscQueries.filter(q=>q.query).slice(0,20);
  const queryCtx = pageQueries.length ? `\nTop queries data: ${pageQueries.map(q=>`"${q.query}" pos:${Math.round(q.position)} impr:${q.impressions}`).join(' | ')}` : '';

  const prompts = {
    q1:`You are an elite SEO strategist for ContentScale.site.\n${ctx}${queryCtx}\nWrite a new SEO title (≤60 chars) and meta desc (≤155 chars) to maximize CTR. Apply 2026 SERP psychology.\n**New Title**: [text]\n**New Meta Description**: [text]\n**Why This Wins**: [rationale]`,
    q2:`You are an elite SEO strategist for ContentScale.site.\n${ctx}\nTop 5 quick wins (<30 min each) to improve position from ${pos}. Be specific — actionable fixes only.\nFormat: **[Action]**: [exact what to do] → Expected: [metric lift]`,
    q3:`You are an elite SEO strategist for ContentScale.site.\n${ctx}${queryCtx}\nIdentify the 3-5 queries where this page ranks position 11-20 — these are the fastest wins to push to page 1. For each: what ONE specific change would push it over the line? Be precise.`,
  };

  for (let i=0;i<QSTEPS.length;i++) {
    const s=QSTEPS[i];
    setStep(s.id,'active');
    try {
      const r = await callGemini(prompts[s.id], 1200);
      addSection(out, s.id, s.icon, s.label, i===0?'b-win':i===1?'b-pulse':'b-gold', r);
      setStep(s.id,'done');
    } catch(e) {
      setStep(s.id,'error');
      addSection(out, s.id, s.icon, s.label, 'b-tech', `**Error:** ${e.message}`);
    }
    bar.style.width=((i+1)/QSTEPS.length*100)+'%';
    if (i<QSTEPS.length-1) await sleep(1200);
  }

  prog.className='progress';
  toast('✅ Quick audit done');
  out.scrollIntoView({behavior:'smooth'});
}

