    d6:`${base}\n\nAVAILABLE SITE URLS FOR INTERNAL LINKING:\n${siteUrlList||'[No site URLs provided — suggest based on URL patterns]'}\n\nSTEP 6 — NEXUS SIGNALS + INTERNAL LINK FINDER: Using the site URLs above, identify:\n1. TOP 5 pages to link FROM to this page (exact anchor text + why)\n2. TOP 5 pages this page should link TO (exact anchor text + why)\n3. 8-10 semantic entities to reinforce (Dutch variants if NL geo)\n4. Where to add first-hand experience markers\n5. 2-3 angles ContentScale can own uniquely\n6. Schema recommendation with exact JSON-LD snippet\n\nFor internal links: use real URLs from the list above — no generic suggestions.`,

    d7:`${base}\n\nSTEP 7 — ARCHITECTURE BLUEPRINT: Based on the CURRENT H1-H3 structure from the actual HTML, show:\n- Current structure (what exists now)\n- Recommended structure (optimized for intent + AI Overview extraction)\n- Side-by-side comparison of each heading change\nEnsure new structure supports both human readability AND Google AI Overview extraction.`,

    d8:`${base}\n\nSTEP 8 — TECHNICAL FIX CHECKLIST: Based on the ACTUAL HTML above:\n1. Keyword placement audit (is "${inp.kw}" in H1? First 100 words? URL? Image alt?)\n2. 5-7 semantic LSI keywords missing from the page\n3. FAQPage JSON-LD schema (3-5 Q&As, 40-60 word answers, AI-Overview optimized)\n4. Featured snippet opportunities (tables/lists that would win one)\n5. Specific HTML issues found (duplicate tags, missing alt, schema errors)\n6. Mobile optimization issues\n\nEvery item: copy-paste ready for a developer.`,

    d9:`${base}\n\nSTEP 9 — BEFORE/AFTER SCORE PROJECTION:\nBased on ContentScale's scoring system (GRAAF 50pts + CRAFT 30pts + Technical 20pts = 100):\n\n1. Estimate CURRENT score breakdown based on actual page content:\n- GRAAF (Genuine/Relevant/Actionable/Accurate/Fresh): [0-50]\n- CRAFT (writing quality signals): [0-30]\n- Technical SEO: [0-20]\n- TOTAL: [0-100]\n\n2. Projected score AFTER implementing all recommendations:\n- GRAAF: [new score + what changed]\n- CRAFT: [new score + what changed]\n- Technical: [new score + what changed]\n- TOTAL: [new score]\n\n3. Expected traffic impact: position ${inp.pos} → projected new position after full implementation\n4. Expected CTR lift: ${inp.ctr}% → projected new CTR\n5. Expected impressions impact at new position`,

    d10:`${base}\n\nSTEP 10 — 90-DAY RANKING PLAN: Organize ALL recommendations from this full audit by Impact × Effort:\n\n🔥 QUICK WINS (do today, <30 min each) — minimum 5 items\n⚙️ MEDIUM EFFORT (this week, 1-3 hours each) — minimum 4 items\n🏆 AUTHORITY BUILDERS (this month, ongoing) — minimum 3 items\n\nFor each item: exact action + expected metric lift.\nSuccess Metrics to track in GSC:\n- At 7 days: [what to check]\n- At 14 days: [what to check]\n- At 30 days: [target position + CTR]\n- At 90 days: [end goal]\n\nTarget: move from position ${inp.pos} → top 10 for "${inp.kw}"`,
  };

  for (let i=0;i<DEEP_STEPS.length;i++) {
    const s=DEEP_STEPS[i];
    setStep(s.id,'active');
    try {
      const result = await callGemini(prompts[s.id], 3500);
      addSection(out, s.id, s.icon, s.label.replace(/Step \d+ — /,''), s.badge, result);
      setStep(s.id,'done');
    } catch(e) {
      setStep(s.id,'error');
      addSection(out, s.id, s.icon, s.label, s.badge, `**Error:** ${e.message}`);
    }
    bar.style.width=((i+1)/DEEP_STEPS.length*100)+'%';
    if (i<DEEP_STEPS.length-1) await sleep(1500);
  }

  prog.className='progress';
  document.getElementById('deepRunBtn').disabled=false;
  toast('✅ Full 10-step audit complete');
  out.scrollIntoView({behavior:'smooth'});
}

// ── Helpers ──
function extractTitle(html) {
  if (!html) return 'not provided';
  const m = html.match(/<title[^>]*>(.*?)<\/title>/i);
  return m ? m[1].trim() : 'not found in HTML';
}
function extractMeta(html) {
  if (!html) return 'not provided';
  const m = html.match(/<meta[^>]*name=["']description["'][^>]*content=["']([^"']+)["']/i)
           || html.match(/<meta[^>]*content=["']([^"']+)["'][^>]*name=["']description["']/i);
  return m ? m[1].trim() : 'not found in HTML';
}
function sleep(ms) { return new Promise(r=>setTimeout(r,ms)); }

function setStep(id, state) {
  const el=document.getElementById('step-'+id);
  if (!el) return;
  el.className='prog-step '+state;
  const icon=el.querySelector('.prog-icon');
  if (state==='active') icon.textContent='⟳';
  else if (state==='done') icon.textContent='✓';
  else if (state==='error') icon.textContent='✗';
}

function addSection(container, id, icon, title, badge, content) {
  const div=document.createElement('div');
  div.className='sec-card';
  div.innerHTML=`
    <div class="sec-head" onclick="toggleBody('${id}')">
      <span style="font-size:17px;">${icon}</span>
      <span class="sec-title">${title}</span>
      <span class="badge ${badge}">${id.toUpperCase()}</span>
      <button class="btn-sm btn-muted" style="margin-left:8px;" onclick="event.stopPropagation();copyMd('md-${id}')">⧉ Copy</button>
    </div>
    <div class="sec-body" id="body-${id}">
      <div class="md" id="md-${id}">${renderMd(content)}</div>
    </div>`;
  container.appendChild(div);
}

function toggleBody(id) {
  document.getElementById('body-'+id)?.classList.toggle('hidden');
}

function copyMd(id) {
  navigator.clipboard.writeText(document.getElementById(id)?.innerText||'').then(()=>toast('Copied!'));
}

function renderMd(t) {
  if (!t) return '';
  return t
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/^### (.+)$/gm,'<h3>$1</h3>')
    .replace(/^## (.+)$/gm,'<h2>$1</h2>')
    .replace(/^# (.+)$/gm,'<h1>$1</h1>')
    .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
    .replace(/\*(.+?)\*/g,'<em>$1</em>')
    .replace(/`([^`\n]+)`/g,'<code>$1</code>')
    .replace(/```[\w]*\n?([\s\S]*?)```/g,'<pre><code>$1</code></pre>')
    .replace(/^&gt; (.+)$/gm,'<blockquote>$1</blockquote>')
    .replace(/^---+$/gm,'<hr>')
    .replace(/^\|(.+)\|$/gm, m => {
      const cells=m.split('|').slice(1,-1);
      if (cells.every(c=>/^[\s\-:]+$/.test(c))) return '';
      return '<tr>'+cells.map(c=>`<td>${c.trim()}</td>`).join('')+'</tr>';
    })
    .replace(/(<tr>[\s\S]*?<\/tr>)+/g, m=>`<table>${m}</table>`)
    .replace(/^[\-\*\•] (.+)$/gm,'<li>$1</li>')
    .replace(/^\d+\. (.+)$/gm,'<li>$1</li>')
    .replace(/(<li>[\s\S]*?<\/li>)+/g, m=>`<ul>${m}</ul>`)
    .replace(/\n\n/g,'</p><p>')
    .replace(/\n/g,'<br>');
}

// ── Drag & drop on upload zones ──
['pagesZone','queriesZone'].forEach(zoneId => {
  const z=document.getElementById(zoneId);
  z.addEventListener('dragover',e=>{e.preventDefault();z.classList.add('drag');});
  z.addEventListener('dragleave',()=>z.classList.remove('drag'));
  z.addEventListener('drop',e=>{
    e.preventDefault();z.classList.remove('drag');
    const file=e.dataTransfer.files[0];
    if (!file) return;
    const r=new FileReader();
    r.onload=ev=>{
      if (zoneId==='pagesZone') { document.getElementById('pagesFile').dispatchEvent; handlePagesCSV({files:[file]}); }
      else handleQueriesCSV({files:[file]});
    };
    r.readAsText(file);
  });
});
</script>
